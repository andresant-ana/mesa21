{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mesa21",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSIONS",
        "class_name": "GameSession"
      },
      {
        "name": "ROOM_LOBBY",
        "class_name": "RoomLobby"
      },
      {
        "name": "ACCOUNT_DIRECTORY",
        "class_name": "AccountDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameSession"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "RoomLobby"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "AccountDirectory"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": ""
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_SESSIONS",
            "class_name": "GameSession"
          },
          {
            "name": "ROOM_LOBBY",
            "class_name": "RoomLobby"
          },
          {
            "name": "ACCOUNT_DIRECTORY",
            "class_name": "AccountDirectory"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "ABUSE_API",
          "namespace_id": "21001",
          "simple": {
            "limit": 360,
            "period": 60
          }
        },
        {
          "name": "ABUSE_AUTH",
          "namespace_id": "21002",
          "simple": {
            "limit": 12,
            "period": 60
          }
        },
        {
          "name": "ABUSE_SIGNUP",
          "namespace_id": "21003",
          "simple": {
            "limit": 4,
            "period": 60
          }
        },
        {
          "name": "ABUSE_ROOMS",
          "namespace_id": "21004",
          "simple": {
            "limit": 150,
            "period": 60
          }
        },
        {
          "name": "ABUSE_SOCKETS",
          "namespace_id": "21005",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ]
    }
  },
  "ratelimits": [
    {
      "name": "ABUSE_API",
      "namespace_id": "21001",
      "simple": {
        "limit": 360,
        "period": 60
      }
    },
    {
      "name": "ABUSE_AUTH",
      "namespace_id": "21002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "ABUSE_SIGNUP",
      "namespace_id": "21003",
      "simple": {
        "limit": 4,
        "period": 60
      }
    },
    {
      "name": "ABUSE_ROOMS",
      "namespace_id": "21004",
      "simple": {
        "limit": 150,
        "period": 60
      }
    },
    {
      "name": "ABUSE_SOCKETS",
      "namespace_id": "21005",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
