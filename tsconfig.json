{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "lib": ["ES2022", "DOM"], "rootDir": ".", "outDir": "dist", "noEmitOnError": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true, "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts"]
}
